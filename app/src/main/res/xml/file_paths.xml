<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Exposes the cache subdirectory where source captures and watermarked
         results are written, so they can be shared via FileProvider URIs. -->
    <cache-path
        name="shared_images"
        path="shared_images/" />
    <!-- Cache subdirectory for exported video results, shared via FileProvider. -->
    <cache-path
        name="shared_videos"
        path="shared_videos/" />
</paths>
